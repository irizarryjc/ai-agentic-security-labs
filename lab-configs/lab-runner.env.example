# lab-runner.env.example
# Illustrative environment template for the disposable coding-agent lab (Chapter 2).
# SAFETY RULE: Never place real API keys, cloud tokens, or database passwords here.
# All secret-like fields below use clearly fake placeholder values.

LAB_HOST=lab-workstation
SANDBOX_DIR=/tmp/ai-agentic-security-sandbox
PROJECT_ROOT=/tmp/ai-agentic-security-sandbox/repo
POLICY_FILE=/tmp/ai-agentic-security-sandbox/policies/default-deny-policy.yaml
LOG_STORE=/tmp/ai-agentic-security-sandbox/logs

# Runner isolation settings (illustrative vendor-neutral knobs)
AGENT_IDENTITY=lab-coding-agent-readonly
AGENT_NETWORK_MODE=none
AGENT_READONLY_ROOTFS=true
APPROVAL_MODE=explicit-full-args

# Fake placeholders only: never substitute production credentials in this lab
LAB_DUMMY_TOKEN=<token>
CANARY_SECRET_FAKE=not-a-real-secret
DB_HOST=127.0.0.1
DB_ROLE=lab_readonly_role
BACKUP_REPO=/tmp/ai-agentic-security-sandbox/backups
